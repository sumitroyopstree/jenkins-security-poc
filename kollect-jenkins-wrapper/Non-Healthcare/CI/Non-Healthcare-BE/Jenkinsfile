        owasp_extra_args                          : '--noupdate',

        perform_code_build               : true,
        node_version                     : '18',
        package_manager                  : 'npm',
        app_name                         : 'jenkins-security-poc',
        build_command                    : 'npm install',
        build_output_path                : '.',
        include_node_modules             : true,
        prune_dev_dependencies           : false,

        unit_testing_check               : true,

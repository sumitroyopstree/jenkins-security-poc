        unit_test_reports_path           : '**/junit*.xml',

        perform_build_dockerfile         : true,
        image_name                       : 'royopstree/jenkins-security-poc',
        dockerfile_location              : 'Dockerfile',
        dockerfile_context               : '.',

        artifact_publish_check           : false,
        dockerhub_publish_check          : true,
        dockerhub_credentials_id         : 'dockerhub-jenkins-security-poc',

        enable_trigger_cd_pipeline       : false,

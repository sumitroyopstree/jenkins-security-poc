        // =========================================================
        // Java / Maven Build
        // =========================================================
        app_stack                         : 'java',
        perform_code_build                : true,
        build_tool                        : 'maven',
        withmaven_globaltool_jdk           : 'Java 17',
        withmaven_globaltool_maven         : 'Maven 3.9',

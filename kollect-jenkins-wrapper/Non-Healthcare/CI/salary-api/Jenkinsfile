        // OWASP Dependency Check
        // =========================================================
        dependency_check                          : 'true',
        dependency_scan_tool                      : 'owasp',
        owasp_project_name                        : 'salary-api',
        owasp_report_publish                      : 'true',
        owasp_report_format                       : 'html',
        fail_job_if_dependency_returned_exception : 'false',

@Library('jenkins-security-poc-library@b664b2efc50de2621053e10f1450402b337bd05a') _

def cdpipeline = new opstree.cd.templates.ssh_pm2.ssh_pm2_deployment()
def targetEnv = (params.ENVIRONMENT ?: 'TEST').toUpperCase()

node {
    currentBuild.description = "CD: jenkins-security-poc | Env: ${targetEnv} | Image: ${params.DOCKER_IMAGE}:${params.DOCKER_TAG}"

    cdpipeline.call([
        enable_jenkins_build_param_override: true,
        deployment_mode                   : 'docker',
        docker_image                      : params.DOCKER_IMAGE ?: 'royopstree/jenkins-security-poc',
        docker_tag                        : params.DOCKER_TAG,
        docker_container_name             : 'jenkins-security-poc',
        docker_host_port                  : 3000,
        docker_container_port             : 3000,
        docker_restart_policy             : 'unless-stopped',
        server_ip                         : '54.91.86.168',
        ssh_user                          : 'ubuntu',
        ssh_credentials_id                : 'aws-vm-ssh-key',
        health_check_endpoint             : 'http://localhost:3000/health',
        docker_run_args                   : '',
        notification_enabled              : false
    ])
}

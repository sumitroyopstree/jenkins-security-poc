    'DEMO': [artifact_s3_bucket_name: 'hrc-cicd-test-bucket', artifact_s3_keypath: 'HRC-Kollect-Cron', aws_region: 'us-east-1', credentials_id: 'hrc-aws-ecr-credentials'],
    'STG' : [artifact_s3_bucket_name: 'hrc-cicd-test-bucket', artifact_s3_keypath: 'HRC-Kollect-Cron', aws_region: 'us-east-1', credentials_id: 'hrc-aws-ecr-credentials'],
    'PROD': [artifact_s3_bucket_name: 'hrc-cicd-test-bucket', artifact_s3_keypath: 'HRC-Kollect-Cron', aws_region: 'us-east-1', credentials_id: 'hrc-aws-ecr-credentials']
]

def currentEnv = envMap[targetEnv] ?: envMap['TEST']


@Library('jenkins-shared-libraries@feature-cicd') _

def targetEnv = (params.ENVIRONMENT ?: 'DEV').toUpperCase()
def imageTag = params.image_tag ?: 'latest'

def envMap = [
    'DEV' : [server_ip: '10.2.40.133', ecr_url: '167121004129.dkr.ecr.us-east-1.amazonaws.com/amd-sync-service-dev'],
    'QA'  : [server_ip: '10.2.10.111', ecr_url: '167121004129.dkr.ecr.us-east-1.amazonaws.com/amd-sync-service-qa'],
    'DEMO': [server_ip: '10.2.40.238', ecr_url: '167121004129.dkr.ecr.us-east-1.amazonaws.com/amd-sync-service-demo'],
    'STG' : [server_ip: '10.2.40.170', ecr_url: '167121004129.dkr.ecr.us-east-1.amazonaws.com/amd-sync-service-stg'],
    'PROD': [server_ip: '10.2.10.118', ecr_url: '167121004129.dkr.ecr.us-east-1.amazonaws.com/amd-sync-service-prod']
]

def currentEnv = envMap[targetEnv] ?: envMap['DEV']

node('HRC-Kollect-Jenkins-Agent') {
    currentBuild.description = "CD: HRC-AMD-Sync-Service | Env: ${targetEnv} | Tag: ${imageTag}"

    def cdPipeline = new opstree.cd.templates.docker_ecr.docker_ecr_deployment()
    cdPipeline.call([
        enable_jenkins_build_param_override: true,
        image_name                          : 'hrc-amd-sync-service',
        ecr_image_url                       : currentEnv.ecr_url,
        server_ip                          : currentEnv.server_ip,
        container_port                      : 8081,
        notification_enabled               : true,
        notification_channel               : 'gmail',
        gmail_notification_from_email_id   : 'smtp@kernernorland.com',
        gmail_notification_recipients_email_ids : 'asangai@healthreconconnect.com'
    ])
}

@Library('jenkins-shared-libraries@feature-cicd') _
def cdpipeline = new opstree.cd.templates.ssh_pm2.ssh_pm2_deployment()

def artifactName = (env.artifact_name ?: params.artifact_name ?: env.image_tag ?: params.image_tag ?: '').trim()
def targetEnv = (env.ENVIRONMENT ?: params.ENVIRONMENT ?: 'TEST').trim().toUpperCase()

def envMap = [
    'TEST': [
        server_ip  : '10.2.30.254',
        deploy_dir : '/opt/hrc-kollect-test/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-test',
        ssh_creds  : 'HRC-Kollect-Test-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:dev.hrckollect.com-tDjPIP'
    ],
    'DEV' : [
        server_ip  : '10.2.40.133',
        deploy_dir : '/opt/hrc-kollect-dev/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-dev',
        ssh_creds  : 'HRC-Kollect-Dev-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:dev.hrckollect.com-tDjPIP'
    ],
    'QA'  : [
        server_ip  : '10.2.10.111',
        deploy_dir : '/opt/hrc-kollect-qa/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-qa',
        ssh_creds  : 'HRC-Kollect-QA-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:qa-hrckollect-com-0mHt87'
    ],
    'DEMO': [
        server_ip  : '10.2.40.238',
        deploy_dir : '/opt/hrc-kollect-demo/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-demo',
        ssh_creds  : 'HRC-Kollect-Demo-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:demo-new-hrckollect-com-KrSHaN'
    ],
    'STG' : [
        server_ip  : '10.2.40.170',
        deploy_dir : '/opt/hrc-kollect-stg/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-stg',
        ssh_creds  : 'HRC-Kollect-Stg-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:stg-hrckollect-com-oLPno0'
    ],
    'PROD': [
        server_ip  : '10.2.10.118',
        deploy_dir : '/opt/hrc-kollect-prod/client-billing-backend',
        app_name   : 'hrc-kollect-client-billing-backend-prod',
        ssh_creds  : 'HRC-Kollect-PROD-Server',
        secret_arn : 'arn:aws:secretsmanager:us-east-1:167121004129:secret:portal.hrckollect.com-xvlUjU'
    ]
]

def currentEnv = envMap[targetEnv] ?: envMap['TEST']

node('HRC-Kollect-Jenkins-Agent') {
    cdpipeline.call([
        enable_jenkins_build_param_override: true,

        // WORKSPACE MANAGEMENT
        clean_workspace                 : true,

        // ENVIRONMENT & BRANCH
        ENVIRONMENT                     : targetEnv,
        BRANCH                          : params.BRANCH ?: 'main',

        // ARTIFACT CONFIGURATION (S3)
        artifact_s3_bucket_name         : 'hrc-cicd-test-bucket',
        artifact_s3_bucket_aws_region   : 'us-east-1',
        artifact_s3_keypath_destination : 'HRC-Kollect-Client-Billing-BE',
        artifact_name                   : artifactName,

        // TARGET VM & ENVIRONMENT BINDINGS
        server_ip                       : currentEnv.server_ip,
        deploy_dir                      : currentEnv.deploy_dir,
        app_name                        : currentEnv.app_name,
        node_version                    : 'v20.18.0',
        ssh_credentials_id              : currentEnv.ssh_creds,
        secret_arn                      : currentEnv.secret_arn,
        secret_region                   : 'us-east-1',
        
        // ENV CONFIGURATION OPTIONS:
        // Option 1: Populate from AWS Secrets Manager (Auto-fetched via secret_arn)
        // Option 2: Provide inline custom env values (Overrides Secrets Manager if provided)
        custom_env_content              : '', 

        // Extra manual .env key-values if needed (e.g. PORT=3200)
        extra_env_vars                  : [
            'PORT'       : '3200',
            'NODE_ENV'   : 'production'
        ],

        run_db_migration                : false,
        start_command                   : 'dist/main.js',
        health_check_endpoint           : 'http://127.0.0.1:3200/api-v2/healthcheck',

        // NOTIFICATIONS
        notification_enabled                    : true,
        notification_channel                    : 'gmail',
        gmail_notification_from_email_id        : 'smtp@kernernorland.com',
        gmail_notification_recipients_email_ids : 'asangai@healthreconconnect.com'
    ])
}
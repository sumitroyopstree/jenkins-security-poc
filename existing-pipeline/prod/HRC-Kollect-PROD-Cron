pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }


    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
        stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-scheduler.git'
                        } else {
                            error "Invalid branch name. The branch must start with ''."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }
        stage('Remove Old data - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server-Cron']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.254 \\
                            'cd /opt/hrc-kollect-prod && pwd && rm -rf ./* && rm -rf ./.env'
                        """
                    }
                }
            }
        }
        stage('Copy Changes to Server - Cron') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf server.tar.gz ./*
                #SCP server directory
                scp -i /opt/prod-keys/HRC-Kollect-PROD-Cron.pem ./server.tar.gz ubuntu@10.2.10.254:/opt/hrc-kollect-prod/
                '''
            }
        }
        stage('Create .env - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server-Cron']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.254 \\
                            'cd /opt/hrc-kollect-prod && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:portal.hrckollect.com-xvlUjU' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
     stage('Remove Old service - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server-Cron']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.254 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v18.0.0 && node -v && cd /opt/hrc-kollect-prod && pwd && pm2 kill'
                        """
                    }
                }
            }
        }   
        stage('Start Backend - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server-Cron']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.254 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v18.0.0 && node -v && cd /opt/hrc-kollect-prod && tar -xzvf server.tar.gz && pwd && yarn && node start-crons.js'
                        """
                    }
                }
            }
        }
        
    }
}
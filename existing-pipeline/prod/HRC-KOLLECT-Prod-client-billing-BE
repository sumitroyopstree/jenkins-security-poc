pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }

    environment {
        PROJECT = 'hrc-kollect-client-billing-backend-prod'
    }
    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
        stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-client-billing-service.git'
                        } else {
                            error "Invalid branch name. The branch must start with ''."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }

        stage('Remove Old data - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-BE']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'cd /opt/client-billing-backend && pwd && mkdir -p logs dist && sudo chown -R ubuntu:ubuntu logs dist && rm -rf ./* && rm -rf ./.env'
                        """
                    }
                }
            }
        }       
        stage('Copy Changes to Server - App') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf hrc-kollect-client-billing-backend.tar.gz .[!.]* *
                # SCP server directory
                scp -i /opt/prod-keys/HRC-Kollect-PROD-BE.pem ./hrc-kollect-client-billing-backend.tar.gz ubuntu@10.2.10.118:/opt/client-billing-backend
                '''
            }
        }
        stage('Create .env - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-BE']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'cd /opt/client-billing-backend && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:portal.hrckollect.com-xvlUjU' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
        stage('Remove Old service - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-BE']) {
                        def serviceRunning = sh (
                        script: """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 list | grep -q "hrc-kollect-client-billing-backend-prod"'
                        """,
                    returnStatus: true
                    )

                if (serviceRunning == 0) {
                    echo "Service is running, deleting..."
                    sh """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/client-billing-backend && pwd && pm2 delete hrc-kollect-client-billing-backend-prod'
                    """
                        } else {
                            echo "Service is not running, skipping removal."
                        }
                    }
                }
            }
        }
        stage('Build client-billing-backend - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-BE']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/client-billing-backend && pwd && sudo rm -rf dist && mkdir -p logs dist && tar -xzvf hrc-kollect-client-billing-backend.tar.gz && sudo chown -R ubuntu:ubuntu /opt/client-billing-backend && ls -ltr && yarn && yarn sequelize db:migrate && pm2 start "yarn start" --name hrc-kollect-client-billing-backend-prod'
                        """
                    }
                }
            }
        }
    }
}
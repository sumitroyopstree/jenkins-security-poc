pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }

    environment {
        // environment variables
        PROJECT = 'hrc-kollect-pay-portal-backend-prod'
        SONARQUBE = 'hrc-sonarqube-stg'  // Jenkins credential ID for token
    }
    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
        stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-payportal-be.git'
                        } else {
                            error "Invalid branch name. The branch must start with ''."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }
        // stage('SonarQube Analysis') {
        //     steps {
        //         withSonarQubeEnv('hrc-sonarqube-qa') {
        //             sh """
        //             /opt/sonar-scanner/sonar-scanner-5.0.1.3006-linux/bin/sonar-scanner \
        //             -Dsonar.projectKey=HRC-Kollect-Pay-Portal-Backend-STG \
        //             -Dsonar.sources=. \
        //             -Dsonar.host.url=http://3.230.96.20:9000 \
        //             -Dsonar.login=$SONARQUBE
        //             """
        //         }
        //     }
        // }
        stage('Remove Old Data - PayPortal-Backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'cd /opt/hrc-kollect-pay-portal-backend-prod && pwd && rm -rf ./* && rm -rf ./.env'
                        """
                    }
                }
            }
        }        
        stage('Copy Changes to Server - PayPortal-Backend') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf hrc-kollect-pay-portal-backend.tar.gz .[!.]* *
                # SCP server directory
                scp -i /opt/prod-keys/HRC-Kollect-PROD-BE.pem ./hrc-kollect-pay-portal-backend.tar.gz ubuntu@10.2.10.118:/opt/hrc-kollect-pay-portal-backend-prod/
                '''
            }
        }
        stage('Create .env - PayPortal-Backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'cd /opt/hrc-kollect-pay-portal-backend-prod && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:portal.hrckollect.com-xvlUjU' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
        stage('Remove Old Service - PayPortal-Backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server']) {
                        def serviceRunning = sh (
                        script: """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 list | grep -q "hrc-kollect-pay-portal-backend-prod"'
                        """,
                    returnStatus: true
                    )

                if (serviceRunning == 0) {
                    echo "Service is running, deleting..."
                    sh """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118\\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 delete hrc-kollect-pay-portal-backend-prod'
                    """
                        } else {
                            echo "Service is not running, skipping removal."
                        }
                    }
                }
            }
        }
        stage('Build - PayPortal-Backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-PROD-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.118 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/hrc-kollect-pay-portal-backend-prod/ && pwd && tar -xzvf hrc-kollect-pay-portal-backend.tar.gz && yarn && pm2 start "yarn start" --name hrc-kollect-pay-portal-backend-prod'
                        """
                    }
                }
            }
        }
    }  // <-- closes stages
}      // <-- closes pipeline
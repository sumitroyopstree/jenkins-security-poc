pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }

    environment {
        PROJECT = 'hrc-kollect-client-billing-frontend-qa'
    }

    stages {

        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )

                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    if (!env.BRANCH_NAME) {
                        error "Branch name is not provided."
                    }

                    git branch: env.BRANCH_NAME,
                        changelog: false,
                        credentialsId: 'hasantha-hrc-gitlab-access',
                        poll: false,
                        url: 'https://gitlab.healthreconconnect.com/hrc/kollect-client-billing-frontend.git'
                }
            }
        }

        stage('Get Pipeline ID') {
            steps {
                script {
                    env.PIPELINE_ID = currentBuild.number.toString()
                    echo "Pipeline ID: ${env.PIPELINE_ID}"
                }
            }
        }

        stage('Remove Old Data - client-billing-frontend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-QA-Server']) {
                        sh '''
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.111 \
                            '
                                mkdir -p /opt/hrc-kollect-qa/client-billing-frontend &&
                                cd /opt/hrc-kollect-qa/client-billing-frontend &&
                                pwd &&
                                rm -rf ./* &&
                                rm -rf ./.next ||
                                true
                            '
                        '''
                    }
                }
            }
        }

        stage('Copy Changes to Server - client-billing-frontend') {
            steps {
                sh '''
                    cd ${WORKSPACE}

                    tar -czf hrc-kollect-client-billing-frontend.tar.gz .[!.]* *

                    scp -i /opt/qa-keys/HRC-Kollect-QA-New-Server.pem \
                        ./hrc-kollect-client-billing-frontend.tar.gz \
                        ubuntu@10.2.10.111:/opt/hrc-kollect-qa/client-billing-frontend/
                '''
            }
        }

        stage('Create .env - client-billing-frontend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-QA-Server']) {
                         sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.111 '
                                cd /opt/hrc-kollect-qa/client-billing-frontend 
                                cat > .env << EOF
NEXT_PUBLIC_CDN_URL=https://d2a99t4hv2ijwl.cloudfront.net
EOF
                    '
                """
                    }
                }
            }
        }

        stage('Remove Old PM2 Service - client-billing-frontend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-QA-Server']) {

                        def serviceRunning = sh(
                            script: '''
                                ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.111\
                                '
                                    source /home/ubuntu/.nvm/nvm.sh &&
                                    nvm use v24.6.0 &&
                                    pm2 list | grep -q "hrc-kollect-client-billing-frontend-qa"
                                '
                            ''',
                            returnStatus: true
                        )

                        if (serviceRunning == 0) {
                            echo "PM2 service exists. Removing..."

                            sh '''
                                ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.111\
                                '
                                    source /home/ubuntu/.nvm/nvm.sh &&
                                    nvm use v24.6.0 &&
                                    pm2 delete hrc-kollect-client-billing-frontend-qa
                                '
                            '''
                        } else {
                            echo "PM2 service not found. Skipping delete."
                        }
                    }
                }
            }
        }

        stage('Build + Start Next.js SSR App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-QA-Server']) {
                        sh '''
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.10.111\
                            '
                                source /home/ubuntu/.nvm/nvm.sh &&
                                nvm use v24.6.0 &&
                                node -v &&

                                cd /opt/hrc-kollect-qa/client-billing-frontend &&
                                pwd &&

                                tar -xzvf hrc-kollect-client-billing-frontend.tar.gz &&

                                npm install &&
                                npm run build &&

                                pm2 start "npm run start" \
                                    --name hrc-kollect-client-billing-frontend-qa

                                pm2 save
                            '
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def pipelineStatus = currentBuild.result ?: 'SUCCESS'
                def bannerColor = pipelineStatus == 'SUCCESS' ? 'green' : 'red'

                def body = """
                <html>
                <body>
                    <div style="border: 4px solid ${bannerColor}; padding: 10px;">
                        <h2>${env.JOB_NAME} - Build ${env.BUILD_NUMBER}</h2>
                        <div style="background-color: ${bannerColor}; padding: 10px;">
                            <h3 style="color: white;">
                                Pipeline Status: ${pipelineStatus}
                            </h3>
                        </div>
                    </div>

                    <p>
                        Console Output:
                        <a href="${env.BUILD_URL}">
                            Open Jenkins Logs
                        </a>
                    </p>
                </body>
                </html>
                """

                emailext(
                    subject: "${env.JOB_NAME} - Build ${env.BUILD_NUMBER} - ${pipelineStatus}",
                    body: body,
                    from: 'smtp@kernernorland.com',
                    replyTo: 'asangai@healthreconconnect.com',
                    mimeType: 'text/html'
                )
            }
        }

        cleanup {
            cleanWs()
        }
    }
}
        stage('Remove Old data - App') {
            steps {
                script {
                    sshagent(['Non-Healthcare-qa-server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.239 \\
                            'cd /opt/non-healthcare-qa/backend && pwd && rm -rf ./* && rm -rf ./.env'
                        """
                    }
                }
            }
        }        
        stage('Copy Changes to Server - App') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf server.tar.gz .[!.]* *
                # SCP server directory
                scp -i /opt/dev-keys/non-healthcare-kollect-qa-key.pem ./server.tar.gz ubuntu@10.2.40.239:/opt/non-healthcare-qa/backend/
                '''
            }
        }
        stage('Create .env - App') {
            steps {
                script {
                    sshagent(['Non-Healthcare-qa-server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no  ubuntu@10.2.40.239\\
                            'cd /opt/non-healthcare-qa/backend && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:qa.nonhealthcare.com-3xKQQa' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
        stage('Remove Old service - App') {
            steps {
                script {
                    sshagent(['Non-Healthcare-qa-server']) {
                        def serviceRunning = sh (
                        script: """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no  ubuntu@10.2.40.239 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v16.17.0 && pm2 list | grep -q "non-healthcare-qa-backend"'
                        """,
                    returnStatus: true
                    )

                if (serviceRunning == 0) {
                    echo "Service is running, deleting..."
                    sh """#!/bin/bash
                         ssh -o StrictHostKeyChecking=no  ubuntu@10.2.40.239 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v16.17.0 && pm2 delete non-healthcare-qa-backend'
                    """
                        } else {
                            echo "Service is not running, skipping removal."
                        }
                    }
                }
            }
        }
        stage('Build Backend - App') {
            steps {
                script {
                    sshagent(['Non-Healthcare-qa-server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.239 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v16.17.0 && node -v && cd /opt/non-healthcare-qa/backend && pwd && tar -xzvf server.tar.gz && yarn && pm2 start "yarn start" --name non-healthcare-qa-backend && yarn sequelize db:migrate'
                        """
                    }
                }
            }
        }

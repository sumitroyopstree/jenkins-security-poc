        stage('Remove Old data - client-billing-backend') {
           steps {
               script {
                   sshagent(['HRC-Kollect-Stg-Server']) {
                       sh """#!/bin/bash
                       ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                          'cd /opt/client-billing-backend && pwd && mkdir -p logs dist && sudo chown -R ubuntu:ubuntu logs dist && rm -rf ./* && rm -rf ./.env'
               """
                 }
            }
       }
       }       
        stage('Copy Changes to Server - client-billing-backend') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf hrc-kollect-client-billing-backend.tar.gz .[!.]* *
                # SCP server directory
                scp -i /opt/stg-keys/hrc-kollect-staging.pem  ./hrc-kollect-client-billing-backend.tar.gz ubuntu@10.2.40.170:/opt/client-billing-backend
                '''
            }
        }
        stage('Create .env - client-billing-backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Stg-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                            'cd /opt/client-billing-backend && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:stg-hrckollect-com-oLPno0' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
        stage('Remove Old service - client-billing-backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Stg-Server']) {
                        def serviceRunning = sh (
                        script: """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 list | grep -q "hrc-kollect-client-billing-backend-stg"'
                        """,
                    returnStatus: true
                    )

                if (serviceRunning == 0) {
                    echo "Service is running, deleting..."
                    sh """#!/bin/bash
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/client-billing-backend && pwd && pm2 delete hrc-kollect-client-billing-backend-stg'
                    """
                        } else {
                            echo "Service is not running, skipping removal."
                        }
                    }
                }
            }
        }
        stage('Build Backend - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Stg-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
            'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/client-billing-backend && pwd && sudo rm -rf dist && mkdir -p logs dist && tar -xzvf hrc-kollect-client-billing-backend.tar.gz && sudo chown -R ubuntu:ubuntu /opt/client-billing-backend && ls -ltr && yarn && pm2 start "yarn start" --name hrc-kollect-client-billing-backend-stg'                      """                   
                    }                   
                 }
            }
        }

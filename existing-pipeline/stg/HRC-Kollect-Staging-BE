pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }
 
    environment {
        // environment variables
        PROJECT = 'hrc-kollect-stg-backend'
    }
    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
        stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-core-service.git'
                        } else {
                            error "Invalid branch name. The branch must start with ''."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }
  
        stage('Copy Changes to Server - App') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf server.tar.gz .[!.]* *
                # SCP server directory
                scp -i /opt/stg-keys/hrc-kollect-staging.pem ./server.tar.gz ubuntu@10.2.40.170:/opt/hrc-kollect-stg/
                '''
            }
        }
 
        stage('Create .env - App') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Stg-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                            'cd /opt/hrc-kollect-stg && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:stg-hrckollect-com-oLPno0' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
 
       stage('Remove Old service - App') {
           steps {
             script {
                    sshagent(['HRC-Kollect-Stg-Server']) {
                     sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 \\
                          'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && node -v && cd /opt/hrc-kollect-stg && pwd && pm2 delete hrc-kollect-stg-backend'
                    """
                }
            }
           }
        }
 
stage('Build Backend - App') {
    steps {
        script {
            sshagent(['HRC-Kollect-Stg-Server']) {
                sh """#!/bin/bash
                ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.170 '
                    source /home/ubuntu/.nvm/nvm.sh
                    nvm use v24.6.0
                    node -v
 
                    cd /opt/hrc-kollect-stg
 
                    # Stop old service
                    pm2 delete hrc-kollect-stg-backend || true
 
                    # Remove old application files but keep .env
                    # Remove old application files but keep .env and deployment archive
                    find . -mindepth 1 \
                        ! -name ".env" \
                        ! -name "server.tar.gz" \
                        -exec rm -rf {} +
 
                    # Extract new deployment
                    tar -xzf server.tar.gz
 
                    # Remove deployment archive after extraction
                    rm -f server.tar.gz
                 
                    # Install dependencies
                    yarn --frozen-lockfile
 
                    # Run database migrations
                    yarn sequelize db:migrate
 
                    # Start application
                    pm2 start "yarn start" --name hrc-kollect-stg-backend
 
                    # Save PM2 configuration
                    pm2 save
                '
                """
               }
          }
     }
    }
}
    post {
        cleanup {
            cleanWs()
        }
    }
}
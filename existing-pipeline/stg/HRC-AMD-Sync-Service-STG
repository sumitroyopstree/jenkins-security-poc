pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent'}

    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.Branch_Name = branchName
                }
            }
        }
        stage('Checkout') {
            steps{
                script {
                    def branchName = env.Branch_Name
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/amd-sync-service.git'
                        } else {
                            error "Invalid branch name. The branch must start with 'any'."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'Branch_Name' environment variable."
                    }
                }
            }
        }
        stage('Get App Version') {
            steps {
                script {
                    def appVersion = sh(script: "cd /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/ && mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                    echo "App Version: ${appVersion}"
                    env.APP_VERSION = appVersion
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID
                }
            }
        }
       stage('Remove Old Image From Jenkins Agent Server'){
           steps {
               script {
                   sh '''#!/bin/bash
                       docker image ls --format '{{.Repository}}:{{.Tag}}' | grep "hrc-amd-sync-service-stg" | sort | xargs docker image rm || true
                       docker image ls --format '{{.Repository}}:{{.Tag}}' | grep "167121004129.dkr.ecr.us-east-1.amazonaws.com/hrc-amd-sync-service-stg" | sort | xargs docker image rm || true
                       docker builder prune -a -f
                   '''    
               }
           }
       }

        stage('Change Docker File to STG Environment') {
           steps {
               script {
                    //sh "sed -i 's/amd-sync-service-APP_Version.jar/kollect-${env.APP_VERSION}.jar/g' /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/Dockerfile"
                    sh "sed -i 's/APP_VERSION/${env.APP_VERSION}/g' /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/Dockerfile"
                    sh "sed -i 's/APP_ENV/stg/g' /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/Dockerfile"
               }
           }
        }

        stage('Build Application & Create Image') {
            steps {
                sh "cd /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/ && mvn clean install -DskipTests -Dspring.profiles.active=stg"
                sh "cd /opt/hrc-kollect/workspace/HRC-AMD-Sync-Service-STG/ && docker build -t hrc-amd-sync-service-stg:${env.PIPELINE_ID} ."
            }
        }
        stage('Image Push to ECR') {
            steps {
                script {
                    sh '''#!/bin/bash
                        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 167121004129.dkr.ecr.us-east-1.amazonaws.com
                    '''    
                }
                sh "docker tag hrc-amd-sync-service-stg:${env.PIPELINE_ID} 167121004129.dkr.ecr.us-east-1.amazonaws.com/hrc-amd-sync-service-stg:${env.PIPELINE_ID}"
                sh "docker image ls"
                sh "docker push 167121004129.dkr.ecr.us-east-1.amazonaws.com/hrc-amd-sync-service-stg:${env.PIPELINE_ID}"
            }
        }
        stage('Remove Old AMD-Sync-Service Images From DEV Server') {
           steps {
              script {
                   sshagent(['HRC-AMD-Kollect-Mediator-DEV']) {
                       sh """#!/bin/bash
                          ssh ubuntu@10.2.1.23 \\
                               'docker image ls --format "{{.Repository}}:{{.Tag}}" | grep "167121004129.dkr.ecr.us-east-1.amazonaws.com/hrc-amd-sync-service-stg" | sort | xargs docker image rm || true ; docker stop hrc-amd-sync-service-stg || true && docker rm hrc-amd-sync-service-stg || true'
                       """
                   }
               }
           }
        }
        stage('Deploy AMD-Sync-Service in STG Server') {
           steps {
               script {
                   sshagent(['HRC-AMD-Kollect-Mediator-DEV']) {
                       sh """#!/bin/bash
                           ssh ubuntu@10.2.1.23 \\
                               'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 167121004129.dkr.ecr.us-east-1.amazonaws.com && docker run -d -p 8080:8081 --name hrc-amd-sync-service-stg 167121004129.dkr.ecr.us-east-1.amazonaws.com/hrc-amd-sync-service-stg:${env.PIPELINE_ID}'
                       """
                   }
               }
           }
        }
    }
}


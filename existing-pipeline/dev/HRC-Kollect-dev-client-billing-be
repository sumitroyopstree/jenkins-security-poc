pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }

    environment {
        // environment variables
        PROJECT = 'hrc-kollect-client-billing-backend-dev'
        SONARQUBE = 'hrc-sonarqube-dev' // Jenkins credential ID for token
    }

    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )

                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
        stage('Clean Git Workspace') {
            steps {
                script {
                    sh '''
                        if [ -d ".git" ]; then
                            echo "Cleaning existing git workspace..."
                            git reset --hard HEAD
                            git clean -fd
                        else
                            echo "No existing Git repository found. Skipping git clean."
                        fi
                    '''
                }
            }
        }
        stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME

                    if (branchName) {
                        git branch: branchName,
                            changelog: false,
                            credentialsId: 'hasantha-hrc-gitlab-access',
                            poll: false,
                            url: 'https://gitlab.healthreconconnect.com/hrc/kollect-client-billing-service.git'
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }

        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }

       stage('SonarQube Analysis') {
           steps {
               withSonarQubeEnv('hrc-sonarqube-dev') {
                   sh """
                       /opt/sonar-scanner/sonar-scanner-5.0.1.3006-linux/bin/sonar-scanner \
                      -Dsonar.projectKey=HRC-Kollect-client-billing-backend-DEV \
                       -Dsonar.sources=. \
                       -Dsonar.host.url=http://10.2.1.209:9000 \
                       -Dsonar.login=$SONAR_AUTH_TOKEN
                """
                }
            }
      }

        // stage('Remove Old Data - client-billing-backend') {
            // steps {
                // script {
                    // sshagent(['HRC-Kollect-Dev-Server']) {
                        // sh """#!/bin/bash
                            // ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                                // cd /tmp &&
                                // rm -rf /opt/hrc-kollect-dev/client-billing-backend/* &&
                                // rm -f /opt/hrc-kollect-dev/client-billing-backend/.env
                            // '
                        // """
                    // }
                // }
            // }
        // }

        stage('Copy Changes to Server - client-billing-backend') {
            steps {
                sh '''#!/bin/bash
                    cd ${WORKSPACE}

                    tar -czf hrc-kollect-client-billing-backend.tar.gz .[!.]* *

                    scp -i /opt/dev-keys/hrc-kollect-dev.pem \
                        ./hrc-kollect-client-billing-backend.tar.gz \
                        ubuntu@10.2.40.133:/opt/hrc-kollect-dev/client-billing-backend/
                '''
            }
        }

        stage('Create .env - client-billing-backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                                cd /opt/hrc-kollect-dev/client-billing-backend &&
                                touch .env &&
                                echo "NODE_ENV=production" >> .env &&
                                echo "SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:dev.hrckollect.com-tDjPIP" >> .env &&
                                echo "SECRET_KEY_MANAGER_REGION=us-east-1" >> .env
                            '
                        """
                    }
                }
            }
        }

        stage('Remove Old Service - client-billing-backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        def serviceRunning = sh(
                            script: """#!/bin/bash
                                ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                                    source /home/ubuntu/.nvm/nvm.sh &&
                                    nvm use v24.6.0 &&
                                    pm2 list | grep -q "hrc-kollect-client-billing-backend-dev"
                                '
                            """,
                            returnStatus: true
                        )

                        if (serviceRunning == 0) {
                            echo "Service is running, deleting..."

                            sh """#!/bin/bash
                                ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                                    source /home/ubuntu/.nvm/nvm.sh &&
                                    nvm use v24.6.0 &&
                                    pm2 delete hrc-kollect-client-billing-backend-dev
                                '
                            """
                        } else {
                            echo "Service is not running, skipping removal."
                        }
                    }
                }
            }
        }

        stage('Build - client-billing-backend') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                                source /home/ubuntu/.nvm/nvm.sh &&
                                nvm use v24.6.0 &&
                                node -v &&
                                cd /opt/hrc-kollect-dev/client-billing-backend/ &&
                        pm2 delete hrc-kollect-client-billing-backend-dev || true
 
                        # Remove old files but keep .env and deployment archive
                        find . -mindepth 1 \
                            ! -name ".env" \
                            ! -name "hrc-kollect-client-billing-backend.tar.gz" \
                            -exec rm -rf {} + 2>/dev/null || true
                            
                                tar -xzvf hrc-kollect-client-billing-backend.tar.gz &&

                                npm install &&
                                npm run build &&
                                pm2 start "npm run start" --name hrc-kollect-client-billing-backend-dev
                            '
                        """
                    }
                }
            }
        }
    }
}
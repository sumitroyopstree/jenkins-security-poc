        stage('Build Frontend') {
            environment {
                nodeJSHome = tool name: 'Node-14.17.0'
                PATH = "${nodeJSHome}/bin:${env.PATH}"
            }
            steps {
                sh '''#!/bin/bash

                cd ${WORKSPACE}
                pwd
                yarn install
                yarn build

                '''
            }
        }
        stage('Deploy Frontend to S3') {
            steps {
                script {
                    sh '''#!/bin/bash
                    cd ${WORKSPACE}
                    aws s3 mv s3://non-healthcare-kollect-dev-fe/* s3://non-healthcare-kollect-dev-fe/${PIPELINE_ID}/ --recursive
                    aws s3 cp dist/ s3://non-healthcare-kollect-dev-fe/ --recursive
                    '''
                }
            }
        }
        stage('CloudFront cache invalidation') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                aws cloudfront create-invalidation --distribution-id EFTZC3GRKKII0 --paths "/*"
                '''
            }
        }
    }
    post {
        always {
            script {
                sh 'pwd'
                def jobName = env.JOB_NAME
                def buildNumber = env.BUILD_NUMBER
                def pipelineStatus = currentBuild.result ?: 'UNKNOWN'
                def bannerColor = pipelineStatus.toUpperCase() == 'SUCCESS' ? 'green' : 'red'
                def sonarQubeLink = "https://sonarqube.kernernorland.com/dashboard?id=${PROJECT}"


                def body = """<html>
                <body>
                    <div style="border: 4px solid ${bannerColor}; padding: 10px;">
                        <h2>${jobName} - Build ${buildNumber}</h2>
                        <div style="background-color: ${bannerColor}; padding: 10px;">
                            <h3 style="color: white;">Pipeline Status: ${pipelineStatus.toUpperCase()}</h3>
                        </div>
                    </div>
                    <p>Check the <a href="${BUILD_URL}">console output</a>.</p>
                    <p>View the <a href="${sonarQubeLink}">SonarQube Report</a>.</p>
                </body>
                </html>"""

                // Write the body content to a file
                writeFile file: 'email_body.html', text: body

                emailext (
                    subject: "${jobName} - Build ${buildNumber} - ${pipelineStatus.toUpperCase()}",
                    body: body,
                //    to: 'kndevops@kernernorland.com,hcim-dev@kernernorland.com',
                    from: 'smtp@kernernorland.com',
                    replyTo: 'jenkins@kernernorland.com',
                    mimeType: 'text/html',
                    // attachmentsPattern: 'reports/*.html'
                )
            }
        }
        cleanup {
            script {
               // Clean up the workspace and any other directories used in the pipeline
               sh 'rm -rf ${WORKSPACE}/*'
            }
        }
    }

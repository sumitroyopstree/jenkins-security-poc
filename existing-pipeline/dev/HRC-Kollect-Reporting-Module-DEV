pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }
    environment {
        SONARQUBE = 'hrc-sonarqube-dev'  // Jenkins SonarQube server config ID
    }

    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.Branch_Name = branchName
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    def branchName = env.Branch_Name
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-report-service.git'
                        } else {
                            error "Invalid branch name. The branch must start with 'any'."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'Branch_Name' environment variable."
                    }
                }
            }
        }

        stage('Get App Version') {
            steps {
                script {
                    def appVersion = sh(
                        script: "cd /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/ && mvn help:evaluate -Dexpression=project.version -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                    echo "App Version: ${appVersion}"
                    env.APP_VERSION = appVersion
                }
            }
        }

        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID
                }
            }
        }

        stage('Build Application (for SonarQube)') {
            steps {
                sh "cd /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/ && mvn clean install -DskipTests -Dspring.profiles.active=dev"
            }
        }

       stage('SonarQube Analysis') {
          steps {
               withSonarQubeEnv('hrc-sonarqube-dev') {
                  sh """
                     /opt/sonar-scanner/sonar-scanner-5.0.1.3006-linux/bin/sonar-scanner \
                     -Dsonar.projectKey=HRC-Kollect-Reporting-Module-DEV \
                     -Dsonar.sources=src/main/java \
                     -Dsonar.java.binaries=/opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/target/classes \
                     -Dsonar.host.url=http://10.2.1.209:9000 \
                     -Dsonar.token=$SONAR_AUTH_TOKEN
                  """
               }
         }
      }

        stage('Remove Old Image From Jenkins Agent Server') {
            steps {
                script {
                    sh '''#!/bin/bash
                        docker image ls --format '{{.Repository}}:{{.Tag}}' | grep "kollect-reporting-module-dev" | sort | xargs docker image rm || true
                        docker image ls --format '{{.Repository}}:{{.Tag}}' | grep "167121004129.dkr.ecr.us-east-1.amazonaws.com/kollect-reporting-module-dev" | sort | xargs docker image rm || true
                        docker builder prune -a -f
                    '''
                }
            }
        }

        stage('Change Docker File to DEV Environment') {
            steps {
                script {
                    sh "sed -i 's/APP_VERSION/${env.APP_VERSION}/g' /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/Dockerfile"
                    sh "sed -i 's/APP_ENV/dev/g' /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/Dockerfile"
                }
            }
        }

        stage('Build Application & Create Image') {
            steps {
                sh "cd /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/ && mvn clean install -DskipTests -Dspring.profiles.active=dev"
                sh "cd /opt/hrc-kollect/workspace/HRC-Kollect-Reporting-Module-DEV/ && docker build -t kollect-reporting-module-dev:${env.PIPELINE_ID} ."
            }
        }

        stage('Image Push to ECR') {
            steps {
                script {
                    sh '''#!/bin/bash
                        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 167121004129.dkr.ecr.us-east-1.amazonaws.com
                    '''
                }
                sh "docker tag kollect-reporting-module-dev:${env.PIPELINE_ID} 167121004129.dkr.ecr.us-east-1.amazonaws.com/kollect-reporting-module-dev:${env.PIPELINE_ID}"
                sh "docker image ls"
                sh "docker push 167121004129.dkr.ecr.us-east-1.amazonaws.com/kollect-reporting-module-dev:${env.PIPELINE_ID}"
            }
        }

        stage('Remove Old Kollect-Reporting-Module Images From DEV Server') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                          ssh -i hrc-kollect-dev.pem  ubuntu@10.2.40.133 \\
                               'docker image ls --format "{{.Repository}}:{{.Tag}}" | grep "167121004129.dkr.ecr.us-east-1.amazonaws.com/kollect-reporting-module-dev" | sort | xargs docker image rm || true ; docker stop kollect-reporting-module-dev || true && docker rm kollect-reporting-module-dev || true'
                        """
                    }
                }
            }
        }

        stage('Deploy Kollect-Reporting-Module in DEV Server') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                           ssh -i hrc-kollect-dev.pem  ubuntu@10.2.40.133 \\
                               'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 167121004129.dkr.ecr.us-east-1.amazonaws.com && docker run -d -p 8080:8080 --name kollect-reporting-module-dev 167121004129.dkr.ecr.us-east-1.amazonaws.com/kollect-reporting-module-dev:${env.PIPELINE_ID}'
                        """
                    }
                }
            }
        }
    }
}

pipeline {
 
    agent { label 'HRC-Kollect-Jenkins-Agent' }
 
    environment {
 
        // environment variables
 
        PROJECT = 'hrc-kollect-dev-backend'
 
        SONARQUBE = 'hrc-sonarqube-dev'  // Jenkins credential ID for token
 
    }
 
    stages {
 
        stage('Input GIT Branch') {
 
            steps {
 
                script {
 
                    def branchName = input(
 
                        id: 'branchInput',
 
                        message: 'Please enter the Git branch name:',
 
                        parameters: [
 
                            string(
 
                                name: 'BRANCH',
 
                                defaultValue: '',
 
                                description: 'Git branch name'
 
                            )
 
                        ]
 
                    )
 
                    currentBuild.description = "Building Git branch: ${branchName}"
 
                    env.BRANCH_NAME = branchName
 
                }
 
            }
 
        }
 
        stage('Clean Git Workspace') {
 
            steps {
 
                script {
 
                    sh '''
 
                        if [ -d ".git" ]; then
 
                            echo "Cleaning existing git workspace..."
 
                            git reset --hard HEAD
 
                            git clean -fd
 
                        else
 
                            echo "No existing Git repository found. Skipping git clean."
 
                        fi
 
                    '''
 
                }
 
            }
 
        }
 
stage('Checkout') {
    steps {
        script {
            def branchName = env.BRANCH_NAME

            if (branchName) {

                if (branchName.startsWith("")) {

                    deleteDir()

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'hasantha-hrc-gitlab-access-new',
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh """
                            set -e

                            git clone https://\$GIT_USER:\$GIT_TOKEN@gitlab.healthreconconnect.com/hrc/kollect-core-service.git .

                            git checkout ${branchName}
                        """
                    }

                } else {
                    error "Invalid branch name. The branch must start with ''."
                }

            } else {
                error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
            }
        }
    }
}
 
        stage('Get Pipeline ID') {
 
            steps {
 
                script {
 
                    def pipelineID = currentBuild.number
 
                    echo "Pipeline ID: ${pipelineID}"
 
                    env.PIPELINE_ID = pipelineID.toString()
 
                }
 
            }
 
        }
 
 

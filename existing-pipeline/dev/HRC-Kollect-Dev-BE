        stage('Copy Changes to Server - App') {
 
            steps {
 
                sh '''#!/bin/bash
 
                cd ${WORKSPACE}
 
                tar -czf server.tar.gz .[!.]* *
 
                # SCP server directory
 
                scp -i /opt/dev-keys/hrc-kollect-dev.pem ./server.tar.gz ubuntu@10.2.40.133:/opt/hrc-kollect-dev/backend/
 
                '''
 
            }
 
        }
 
        stage('Create .env - App') {
    steps {
        script {
            sshagent(['HRC-Kollect-Dev-Server']) {
                sh """#!/bin/bash
                    ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 "
                        cd /opt/hrc-kollect-dev/backend &&
                        pwd &&
                        touch .env &&
                        echo NODE_ENV=production >> .env &&
                        echo SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:dev.hrckollect.com-tDjPIP >> .env &&
                        echo SECRET_KEY_MANAGER_REGION=us-east-1 >> .env
                    "
                """
            }
        }
    }
}
        stage('Remove Old service - App') {
 
            steps {
 
                script {
 
                    sshagent(['HRC-Kollect-Dev-Server']) {
 
                        def serviceRunning = sh (
 
                        script: """#!/bin/bash
 
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
 
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 list | grep -q "hrc-kollect-dev-backend"'
 
                        """,
 
                    returnStatus: true
 
                    )
 
                if (serviceRunning == 0) {
 
                    echo "Service is running, deleting..."
 
                    sh """#!/bin/bash
 
                        ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
 
                        'source /home/ubuntu/.nvm/nvm.sh && nvm use v24.6.0 && pm2 delete hrc-kollect-dev-backend'
 
                    """
 
                        } else {
 
                            echo "Service is not running, skipping removal."
 
                        }
 
                    }
 
                }
 
            }
 
        }
 
 
    stage('Build Backend - App') {
        steps {
            script {
                sshagent(['HRC-Kollect-Dev-Server']) {
                    sh """#!/bin/bash
                    ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 '
                        set -e
 
                        source /home/ubuntu/.nvm/nvm.sh
                        nvm use v24.6.0
                        node -v
 
                        cd /opt/hrc-kollect-dev/backend
 
                        # Stop old service
                        pm2 delete hrc-kollect-dev-backend || true
 
                        # Remove old files but keep .env and deployment archive
                        find . -mindepth 1 \
                            ! -name ".env" \
                            ! -name "server.tar.gz" \
                            -exec rm -rf {} + 2>/dev/null || true
                        # Extract deployment
                        tar -xzf server.tar.gz
                        rm -f server.tar.gz
 
                        # Install dependencies
                        yarn --frozen-lockfile
 
                        # Run migrations
                        yarn sequelize db:migrate
 
                        # Start application
                        pm2 start "yarn start" --name hrc-kollect-dev-backend
 
                        # Save PM2 configuration
                        pm2 save
                    '
                    """
                }
            }
        }
    }
 
    }  // <-- closes stages
 
}      // <-- closes pipeline
 
pipeline {
    agent { label 'HRC-Kollect-Jenkins-Agent' }


    stages {
        stage('Input GIT Branch') {
            steps {
                script {
                    def branchName = input(
                        id: 'branchInput',
                        message: 'Please enter the Git branch name:',
                        parameters: [
                            string(
                                name: 'BRANCH',
                                defaultValue: '',
                                description: 'Git branch name'
                            )
                        ]
                    )
                    currentBuild.description = "Building Git branch: ${branchName}"
                    env.BRANCH_NAME = branchName
                }
            }
        }
            stage('Checkout') {
            steps {
                script {
                    def branchName = env.BRANCH_NAME
                    if (branchName) {
                        if (branchName.startsWith("")) {
                            git branch: branchName,
                                changelog: false,
                                credentialsId: 'hasantha-hrc-gitlab-access',
                                poll: false,
                                url: 'https://gitlab.healthreconconnect.com/hrc/kollect-scheduler.git'
                        } else {
                            error "Invalid branch name. The branch must start with ''."
                        }
                    } else {
                        error "Branch name is not provided. Please set the 'BRANCH_NAME' environment variable."
                    }
                }
            }
        }
        stage('Get Pipeline ID') {
            steps {
                script {
                    def pipelineID = currentBuild.number
                    echo "Pipeline ID: ${pipelineID}"
                    env.PIPELINE_ID = pipelineID.toString()
                }
            }
        }
        stage('Remove Old data - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
                            'cd /opt/hrc-kollect-dev/cron/ && pwd && rm -rf ./* && rm -rf ./.env'
                        """
                    }
                }
            }
        }
        stage('Copy Changes to Server - Cron') {
            steps {
                sh '''#!/bin/bash
                cd ${WORKSPACE}
                tar -czf server.tar.gz ./*
                #SCP server directory
                scp -i /opt/dev-keys/hrc-kollect-dev.pem ./server.tar.gz ubuntu@10.2.40.133:/opt/hrc-kollect-dev/cron/
                '''
            }
        }
        stage('Create .env - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
                            'cd /opt/hrc-kollect-dev/cron/ && pwd && touch .env && echo 'NODE_ENV=production' >> .env && echo 'SECRET_KEY_MANAGER_KEY=arn:aws:secretsmanager:us-east-1:167121004129:secret:dev.hrckollect.com-tDjPIP' >> .env && echo 'SECRET_KEY_MANAGER_REGION=us-east-1' >> .env'
                        """
                    }
                }
            }
        }
        
        
        
stage('Remove Old service - Cron') {
    steps {
        script {
            def pm2Services = [
                "cancelCampaignQueuedData",
                "paymentAutoDebit",
                "schedulePaperCampaign",
                "sendEmailDeamon",
                "sendPaperTemplate",
                "sendSmsDeamon",
                "smsCampaignSchedule",
                "smsCampaignScheduleDataForChunkTable",
                "squareRefreshToken",
                "userInactiveProcess"
            ]

            sshagent(['HRC-Kollect-Dev-Server']) {
                for (service in pm2Services) {
                    def serviceRunning = sh (
                        script: """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v18.0.0 && pm2 jlist | jq -e \'.[] | select(.name=="${service}")\' > /dev/null'
                        """,
                        returnStatus: true
                    )

                    if (serviceRunning == 0) {
                        echo "Service ${service} is running, deleting..."
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v18.0.0 && pm2 delete "${service}"'
                        """
                    } else {
                        echo "Service ${service} is not running, skipping removal."
                    }
                }
            }
        }
    }
}

        
        
        
        
        stage('Start Backend - Cron') {
            steps {
                script {
                    sshagent(['HRC-Kollect-Dev-Server']) {
                        sh """#!/bin/bash
                            ssh -o StrictHostKeyChecking=no ubuntu@10.2.40.133 \\
                            'source /home/ubuntu/.nvm/nvm.sh && nvm use v18.0.0 && node -v && cd /opt/hrc-kollect-dev/cron/ && tar -xzvf server.tar.gz && pwd && npm install && node start-crons.js'
                        """
                    }
                }
            }
        }
    }
}